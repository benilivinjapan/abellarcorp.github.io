/* Contact Section Styling */
.landing-contact {
  background-color: #0d0d0d;
  padding: 80px 20px;
  color: #f5f5f5;
  border-top: 1px solid #211c18;
}

.contact-container {
  max-width: 1100px;
  margin: 0 auto;
}

.contact-header {
  text-align: center;
  margin-bottom: 50px;
}

.contact-subtext {
  color: #b8b0a6;
  font-size: 1.05rem;
  max-width: 600px;
  margin: 10px auto 0 auto;
}

/* 2-Column Layout */
.contact-grid {
  display: grid;
  grid-template-columns: 1fr 1.2fr;
  gap: 50px;
  align-items: start;
}

@media (max-width: 768px) {
  .contact-grid {
    grid-template-columns: 1fr;
  }
}

/* Info Cards */
.contact-info {
  background: #181412;
  border: 1px solid #8b6b3e;
  border-radius: 8px;
  padding: 35px;
}

.info-block {
  margin-bottom: 30px;
}

.info-block:last-child {
  margin-bottom: 0;
}

.info-block h3 {
  color: #d4af37;
  font-size: 1.15rem;
  margin-bottom: 8px;
}

.info-block p {
  color: #b8b0a6;
  line-height: 1.6;
  margin: 0;
}

/* Form Styles */
.contact-form-wrapper {
  background: #121212;
  border: 1px solid #333333;
  border-radius: 8px;
  padding: 35px;
}

.form-group {
  margin-bottom: 20px;
}

.form-group label {
  display: block;
  font-size: 0.85rem;
  color: #d4af37;
  letter-spacing: 1px;
  text-transform: uppercase;
  margin-bottom: 8px;
}

.form-group input,
.form-group textarea {
  width: 100%;
  background-color: #1a1a1a;
  border: 1px solid #333333;
  border-radius: 4px;
  padding: 12px 15px;
  color: #ffffff;
  font-size: 1rem;
  transition: border-color 0.3s ease;
}

.form-group input:focus,
.form-group textarea:focus {
  outline: none;
  border-color: #ffd700;
}

/* Submit Button */
.btn-gold-submit {
  width: 100%;
  background-color: #d4af37;
  color: #000000;
  font-weight: bold;
  font-size: 1rem;
  border: none;
  padding: 14px;
  border-radius: 4px;
  cursor: pointer;
  transition: all 0.3s ease;
}

.btn-gold-submit:hover {
  background-color: #ffd700;
  transform: translateY(-2px);
}
